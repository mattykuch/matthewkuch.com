;; matthewkuch.com — DNS for GitHub Pages
;; Import into Cloudflare: DNS > Records > Import DNS Records > upload this file.
;;
;; TTL of 1 means "Auto" in Cloudflare.
;;
;; !! AFTER IMPORTING, set every record's Proxy status to "DNS only" (grey cloud). !!
;; An orange cloud makes Cloudflare terminate TLS, which stops GitHub issuing its
;; certificate and can cause redirect loops.

matthewkuch.com.	1	IN	A	185.199.108.153
matthewkuch.com.	1	IN	A	185.199.109.153
matthewkuch.com.	1	IN	A	185.199.110.153
matthewkuch.com.	1	IN	A	185.199.111.153
matthewkuch.com.	1	IN	AAAA	2606:50c0:8000::153
matthewkuch.com.	1	IN	AAAA	2606:50c0:8001::153
matthewkuch.com.	1	IN	AAAA	2606:50c0:8002::153
matthewkuch.com.	1	IN	AAAA	2606:50c0:8003::153
www.matthewkuch.com.	1	IN	CNAME	mattykuch.github.io.
